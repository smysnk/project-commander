# Shared
SERVER_PORT=4000
WEB_PORT=3000
SERVER_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
RUN_MIGRATIONS_ON_STARTUP=true

# Google OAuth / NextAuth
NEXTAUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ALLOWED_USERS=josh@psidox.com

# Runtime backend (go-master is the only supported mode)
PC_MASTER_SOCKET_PATH=/tmp/project-commander/master.sock
# Console log level for pc-master process output.
# Allowed: trace, debug, info, warn, error.
# This only affects terminal/stdout logging and does not change logs recorded in the app runtime stream.
PC_MASTER_CONSOLE_LOG_LEVEL=info
# TCP endpoint master exposes for slave registration/heartbeat RPCs
PC_MASTER_SLAVE_LISTEN_ADDR=127.0.0.1:50052
# Optional override used for local host deployments so slave can dial master via filesystem socket.
# If empty, local deployments fall back to PC_MASTER_SOCKET_PATH.
PC_MASTER_SLAVE_SOCKET_PATH=/tmp/project-commander/master.sock
# Shared key required for slave->master registration and heartbeat
PC_SLAVE_SHARED_KEY=change-me
# Slave default master endpoint (used by pc-slave). Can be TCP host:port or unix:///path/to/socket.
PC_MASTER_ENDPOINT=127.0.0.1:50052
# Console log level for pc-slave process output.
# Allowed: trace, debug, info, warn, error.
PC_SLAVE_CONSOLE_LOG_LEVEL=info
# Console log level for the Node backend process output.
# Allowed: trace, debug, info, warn, error.
PC_SERVER_CONSOLE_LOG_LEVEL=info
# Slave heartbeat cadence to master (health check frequency)
PC_HEARTBEAT_INTERVAL=2s
# Optional port advertised by the slave during registration
PC_SLAVE_PORT=0
# Master timeout before marking a slave connection as disconnected
PC_MASTER_SLAVE_HEARTBEAT_TIMEOUT=8s
# How often master evaluates slave heartbeat freshness
PC_MASTER_SLAVE_HEALTH_CHECK_INTERVAL=1s
# Optional project root that slave will launch and supervise
# If set, slave launches PC_SLAVE_LAUNCH_COMMAND and watches <project>/packages for changes.
PC_SLAVE_PROJECT_PATH=
# Shared default project root used by all deployed slave agents when PC_SLAVE_PROJECT_PATH is not set.
# If this value is empty, slave falls back to ~/play and creates it at startup when missing.
PC_SLAVE_DEFAULT_PROJECT_PATH=~/test
# Default slave launch command for supervised workloads
PC_SLAVE_LAUNCH_COMMAND=yarn dev
# Poll interval for package watch + reload
PC_SLAVE_WATCH_INTERVAL=1s
# How long the slave keeps historical managed-process log directories and stale sidecars.
# Set to 0 to disable age-based cleanup.
PC_SLAVE_RUNTIME_ARTIFACT_RETENTION=168h
# How many prior boot log directories the slave keeps in addition to the current boot.
# Set to 0 to disable count-based cleanup.
PC_SLAVE_MAX_RETAINED_BOOT_LOGS=10
# Timeout for slave-side git clone checkout commands
PC_SLAVE_CHECKOUT_TIMEOUT=10m
# Slave discovery scan interval for reporting projects to master
PC_SLAVE_DISCOVERY_INTERVAL=10s
# Max depth for slave project discovery scan
PC_SLAVE_DISCOVERY_MAX_DEPTH=6
# Seconds to wait for slave->master registration when deploying a host manually
PC_SLAVE_DEPLOY_VERIFY_TIMEOUT_SECONDS=45
# Number of deployment verification attempts before marking host deploy failed
PC_SLAVE_DEPLOY_VERIFY_RETRIES=3
# Delay between deployment verification retries
PC_SLAVE_DEPLOY_VERIFY_RETRY_DELAY_SECONDS=8
# Optional sudo/root password used for slave deployment and upgrade operations that require elevation.
# When set, the backend will use it before prompting the frontend.
PC_DEPLOY_SUDO_PASSWORD=
# Optional alias for PC_DEPLOY_SUDO_PASSWORD.
PC_ROOT_PASSWORD=
# Seconds to wait for a frontend-provided sudo password when deployment requires elevation
PC_DEPLOY_SUDO_PASSWORD_TIMEOUT_SECONDS=120
# Automatically upgrade/re-deploy slave agents when their reported version differs from the local target version.
PC_SLAVE_AUTO_UPGRADE_ENABLED=true
# Cooldown between automatic upgrade attempts for the same host after a mismatch is detected.
PC_SLAVE_AUTO_UPGRADE_COOLDOWN_SECONDS=60

# Discovery runtime config
PROJECT_PATH=.
PROJECT_FOLDER_PATTERN=.*
SCAN_MAX_DEPTH=6

# Database (Sequelize)
# If DATABASE_URL is set, it is used by default.
# Set DB_USE_DATABASE_URL=false to force local sqlite.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/project_commander
# DB_USE_DATABASE_URL=true
DB_DIALECT=sqlite
DB_STORAGE=./packages/server/data/project-commander.sqlite
