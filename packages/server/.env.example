# Server runtime
NODE_ENV=development
SERVER_PORT=4000
WEB_PORT=3000
WS_URL=ws://localhost:4000/ws
APP_URL=http://localhost:3000
PC_SERVER_CONSOLE_LOG_LEVEL=info
PC_DEPLOY_SUDO_PASSWORD=
PC_ROOT_PASSWORD=
PC_SLAVE_AUTO_UPGRADE_ENABLED=true
PC_SLAVE_AUTO_UPGRADE_COOLDOWN_SECONDS=60

# Discovery config
PROJECT_PATH=../..
PROJECT_FOLDER_PATTERN=.*
SCAN_MAX_DEPTH=6

# Migration behavior
RUN_MIGRATIONS_ON_STARTUP=true

# Database (Sequelize)
# DATABASE_URL=postgres://project_commander:project_commander@localhost:5432/project_commander
# DB_USE_DATABASE_URL=true
DB_DIALECT=sqlite
DB_STORAGE=./packages/server/data/project-commander.sqlite
